CONFIG_ENV=config/bluejay.env
KERNEL_SOURCE=https://github.com/aosp-mirror/kernel_common
KERNEL_SOURCE_BRANCH=android14-6.1-lts
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379
USE_LLVM=true
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
EXTRA_CMDS:
CUSTOM_CMDS:
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=auto
ENABLE_KPM=false
ENABLE_SUSFS=true
SUSFS_BRANCH=gki-android14-6.1
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
